# OktaTrace settings are read from environment variables; this file documents
# them. All are optional. Never commit a .env containing real values.

# Token lifetime (hours) above which a credential is flagged as long-lived.
OKTATRACE_LONG_LIVED_HOURS=8

# Largest HAR upload accepted by the API, in MB.
OKTATRACE_MAX_HAR_MB=25

# Browser origins allowed to call the API (comma-separated).
OKTATRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where sample and generated artefacts live (defaults to ./data).
# OKTATRACE_DATA_DIR=

# SQLite database for the generated log (defaults to data/generated/oktatrace.db).
# OKTATRACE_DB_PATH=

# Seed used when the API auto-generates the dataset.
OKTATRACE_SEED=20231020

# Report summarizer (Module 6): auto | llm | template.
# auto = Claude if ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN is set, otherwise the offline template.
OKTATRACE_SUMMARY_MODE=auto
OKTATRACE_LLM_MODEL=claude-opus-5-5
OKTATRACE_LLM_TIMEOUT_SECONDS=120

# Read by the Anthropic SDK itself; set it in your shell, never commit it.
# ANTHROPIC_API_KEY=
